    {
      "parameters": {
        "description": "Use this tool to generate a visual pie chart image URL for category spending breakdown.\nProvide labels (comma separated categories) and data (comma separated total amounts).",
        "jsCode": "// 1. Ambil input query dari AI\nconst rawQuery = (typeof query !== 'undefined' ? query : $input.first()?.json?.query) || '';\n\nlet labels = ['Food', 'Transportation'];\nlet data = [100000, 50000];\nlet title = 'Breakdown Pengeluaran';\n\n// 2. Parsing format query (contoh: \"labels=Jajan,Food&data=200000,50000\" atau JSON)\ntry {\n  if (rawQuery.includes('=')) {\n    const params = new URLSearchParams(rawQuery);\n    if (params.get('labels')) labels = params.get('labels').split(',').map(s => s.trim());\n    if (params.get('data')) data = params.get('data').split(',').map(s => Number(s.trim()));\n    if (params.get('title')) title = params.get('title').trim();\n  } else if (rawQuery.startsWith('{')) {\n    const parsed = JSON.parse(rawQuery);\n    if (parsed.labels) labels = Array.isArray(parsed.labels) ? parsed.labels : parsed.labels.split(',');\n    if (parsed.data) data = Array.isArray(parsed.data) ? parsed.data : parsed.data.split(',').map(Number);\n    if (parsed.title) title = parsed.title;\n  }\n} catch (e) {\n  // Gunakan fallback default jika parsing gagal\n}\n\n// 3. Susun konfigurasi QuickChart\nconst chartConfig = {\n  type: 'pie',\n  data: {\n    labels: labels,\n    datasets: [{\n      data: data,\n      backgroundColor: [\n        '#FF6384', '#36A2EB', '#FFCE56', '#4BC0C0', '#9966FF', '#FF9F40', '#C9CBCF'\n      ]\n    }]\n  },\n  options: {\n    plugins: {\n      title: {\n        display: true,\n        text: title\n      },\n      legend: {\n        position: 'right'\n      }\n    }\n  }\n};\n\nconst encodedConfig = encodeURIComponent(JSON.stringify(chartConfig));\n\n// 4. Return URL sebagai string tunggal\nreturn `https://quickchart.io/chart?c=${encodedConfig}&w=500&h=300&bkg=white`;"
      },
      "type": "@n8n/n8n-nodes-langchain.toolCode",
      "typeVersion": 1.3,
      "position": [
        2464,
        928
      ],
      "id": "b4c0d57e-81ab-47b1-ae6f-398d3eca51e0",
      "name": "generate_chart"
