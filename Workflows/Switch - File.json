    {
      "parameters": {
        "jsCode": "// 1. Ambil payload input dari node sebelumnya\nconst input = $input.first()?.json || {};\n\n// 2. Ambil data pesan teks langsung dari Telegram\nconst telegramText = $('Start').first()?.json._firstItem?.message?.text;\n\n// 3. Ekstraksi teks dari struktur output Gemini Vision / Transcribe / Standard\nconst extractedText = \n  input.content?.parts?.[0]?.text ||   // Path dari Analyze an image (Gemini)\n  input.text || \n  input.transcription || \n  input.text_output || \n  input.output ||\n  input.response?.text ||\n  input.candidates?.[0]?.content?.parts?.[0]?.text;\n\n// 4. Tentukan teks akhir\nlet promptText = telegramText || extractedText || '';\n\n// 5. Metadata Telegram\nconst triggerData = $('Start').first()?.json._firstItem?.message || {};\nconst chatId = triggerData.chat?.id || input.chat_id || 0;\nconst userId = triggerData.from?.id || input.user_id || 0;\nconst userName = triggerData.from?.first_name || input.user_name || 'User';\n\nreturn [\n  {\n    json: {\n      chat_id: chatId,\n      user_id: userId,\n      user_name: userName,\n      user_prompt: String(promptText).trim(),\n      timestamp: new Date().toISOString()\n    }\n  }\n];"
      },
